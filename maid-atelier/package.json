{
  "name": "@wjingshan/dsh-client-ui-skin-maid-atelier",
  "description": "Hot-pluggable Deep-sea maid atelier skin with character backdrop and ornamental navy UI for the dsh web GUI",
  "version": "0.1.3",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && node ../scripts/write-skin-build.mjs . wjingshan/dsh-deep-whale",
    "test": "vitest run"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjingshan/dsh-deep-whale.git",
    "directory": "maid-atelier"
  },
  "homepage": "https://github.com/wjingshan/dsh-deep-whale/tree/main/maid-atelier#readme",
  "bugs": {
    "url": "https://github.com/wjingshan/dsh-deep-whale/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "0.22.14",
    "vitest": "4.1.10"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "skin.json",
    "skin.build.json",
    "preview",
    "assets/icons/*.ico",
    "LICENSE",
    "LICENSE-ARTWORK",
    "NOTICE",
    "README.md"
  ]
