{
  "name": "@smalltailqwq/dsh-client-ui-skin-maid-atelier",
  "description": "Two whale maids, navy lace and a chibi sidebar turn DSH into a maid atelier.",
  "icon": "assets/plugin-icon.png",
  "version": "0.1.4",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ../scripts/prepare-skin-assets.mjs . && tsdown && node ../scripts/write-skin-build.mjs . Small-tailqwq/dsh-deep-whale",
    "test": "vitest run"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Small-tailqwq/dsh-deep-whale.git",
    "directory": "maid-atelier"
  },
  "homepage": "https://github.com/Small-tailqwq/dsh-deep-whale/tree/main/maid-atelier#readme",
  "bugs": {
    "url": "https://github.com/Small-tailqwq/dsh-deep-whale/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.1.8-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "0.22.14",
    "vitest": "4.1.10"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "skin.json",
    "skin.build.json",
    "preview",
    "assets/icons/*.ico",
    "LICENSE",
    "LICENSE-ARTWORK",
    "NOTICE",
    "README.md",
    "assets/runtime",
    "locale/*.json",
    "assets/plugin-icon.png"
  ]
}
