{
  "name": "@dsh-external/dsh-client-ui-skin-deep-whale-manager",
  "description": "Settings-integrated discovery, activation, and skin-owned customization for DSH Web skins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./protocol": {
      "types": "./src/protocol.ts",
      "import": "./lib/protocol.js",
      "default": "./lib/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/protocol.js",
    "cordis.patch.yml",
    "src",
    "tests",
    "README.md",
    "LICENSE"
  ]
}
